# ExplainMyCode IDE — Backend Environment Variables
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# Required — will not start without these
# ─────────────────────────────────────────────

# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any long random string — used to sign JWTs
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# ─────────────────────────────────────────────
# Database (defaults to local SQLite — no setup needed)
# ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./explainmycode.db

# Uncomment to use PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/explainmycode

# ─────────────────────────────────────────────
# Optional — Code Execution via Judge0
# ─────────────────────────────────────────────
# Get from https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com

# ─────────────────────────────────────────────
# Optional — Redis (for caching, defaults to localhost)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# CORS — comma-separated list of allowed frontend origins
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────
# Dev settings
# ─────────────────────────────────────────────
DEBUG=False
SQLALCHEMY_ECHO=False
